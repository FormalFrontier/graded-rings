module

import GradedRings.PolynomialModule.Finiteness
import Mathlib.Data.Matrix.Mul

/-!
# Finite generation over a noncommutative semiring

The left regular module over the semiring of two-by-two matrices over `ℕ` is
cyclic. Its polynomial extension is therefore finitely generated by the
preservation instance. This coefficient semiring is noncommutative, and its
additive monoid has no additive group structure.
-/

@[expose] public section

example : Module.Finite (Polynomial (Matrix (Fin 2) (Fin 2) ℕ))
    (PolynomialModule.Extension (Matrix (Fin 2) (Fin 2) ℕ)
      (Matrix (Fin 2) (Fin 2) ℕ)) := inferInstance
