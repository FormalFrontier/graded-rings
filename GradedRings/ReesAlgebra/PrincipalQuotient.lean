module

public import GradedRings.ReesAlgebra.PrincipalPolynomial
public import Mathlib.Algebra.Polynomial.Eval.Coeff
public import Mathlib.Algebra.Polynomial.Eval.SMul

/-!
# A polynomial cover of a principal Rees quotient

For a principal ideal `I = Ideal.span {a}`, the quotient of `reesAlgebra I` by
`Ideal.map (algebraMap R (reesAlgebra I)) I` is a quotient of `R[X]`. The covering
homomorphism is obtained from the principal polynomial homomorphism over `R ⧸ I`
by reducing coefficients. In particular, its surjectivity does not require `a` to
be regular.
-/

@[expose] public section

open Polynomial

universe u

namespace Ideal

variable {R : Type u} [CommRing R]

/-- The degree-one generator of the Rees algebra of a principal ideal. -/
noncomputable def principalReesGenerator (a : R) : reesAlgebra (Ideal.span ({a} : Set R)) :=
  ⟨Polynomial.C a * Polynomial.X, by
    have h : Polynomial.monomial 1 a ∈ reesAlgebra (Ideal.span ({a} : Set R)) :=
      reesAlgebra.monomial_mem.mpr (by
        simpa only [pow_one] using Ideal.mem_span_singleton_self a)
    simpa only [← Polynomial.C_mul_X_pow_eq_monomial, pow_one] using h⟩

@[simp]
theorem coe_principalReesGenerator (a : R) :
    (principalReesGenerator a : R[X]) = Polynomial.C a * Polynomial.X :=
  rfl

/-- The polynomial cover of the Rees quotient of the ideal generated by `a`.
It is the principal polynomial homomorphism after reduction of coefficients. -/
noncomputable def principalReesQuotientHom (a : R) :
    R[X] →+* (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
      Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
        (Ideal.span ({a} : Set R))) :=
  (reesAlgebra.principalPolynomialHom a).toRingHom.comp
    (Polynomial.mapRingHom (Ideal.Quotient.mk (Ideal.span ({a} : Set R))))

/-- Applying the cover amounts to reducing coefficients and applying the principal
polynomial homomorphism. -/
theorem principalReesQuotientHom_apply_map (a : R) (p : R[X]) :
    principalReesQuotientHom a p =
      reesAlgebra.principalPolynomialHom a
        (Polynomial.map (Ideal.Quotient.mk (Ideal.span ({a} : Set R))) p) :=
  rfl

/-- The polynomial cover sends a constant to its canonical scalar in the Rees quotient. -/
@[simp]
theorem principalReesQuotientHom_C (a r : R) :
    principalReesQuotientHom a (Polynomial.C r) =
      algebraMap R (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
        Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R))) r := by
  rw [principalReesQuotientHom_apply_map, Polynomial.map_C,
    reesAlgebra.principalPolynomialHom_C,
    IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span ({a} : Set R))
      (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
        Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))]
  rfl

/-- On constants the cover agrees with the original scalar map through the Rees algebra. -/
theorem principalReesQuotientHom_C_eq_mk (a r : R) :
    principalReesQuotientHom a (Polynomial.C r) =
      Ideal.Quotient.mk
        (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))
        (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))) r) := by
  rw [principalReesQuotientHom_C,
    IsScalarTower.algebraMap_apply R (reesAlgebra (Ideal.span ({a} : Set R)))
      (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
        Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))]
  rfl

/-- The polynomial variable maps to the class of the degree-one Rees generator. -/
@[simp]
theorem principalReesQuotientHom_X (a : R) :
    principalReesQuotientHom a Polynomial.X =
      Ideal.Quotient.mk
        (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))
        (principalReesGenerator a) := by
  rw [principalReesQuotientHom_apply_map, Polynomial.map_X,
    reesAlgebra.principalPolynomialHom_X]
  trans Ideal.Quotient.mk
    (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
      (Ideal.span ({a} : Set R)))
    (⟨Polynomial.monomial 1 a, reesAlgebra.monomial_mem.mpr (by
      simpa only [pow_one] using Ideal.mem_span_singleton_self a)⟩ :
      reesAlgebra (Ideal.span ({a} : Set R)))
  · rfl
  · apply congrArg (Ideal.Quotient.mk _)
    apply Subtype.ext
    simpa only [coe_principalReesGenerator, pow_one] using
      (Polynomial.C_mul_X_pow_eq_monomial (a := a) (n := 1)).symm

/-- The cover evaluates polynomials at the class of the principal Rees generator. -/
theorem principalReesQuotientHom_eq_eval₂RingHom (a : R) :
    principalReesQuotientHom a =
      Polynomial.eval₂RingHom
        (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
          Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
            (Ideal.span ({a} : Set R))))
        (Ideal.Quotient.mk
          (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
            (Ideal.span ({a} : Set R)))
          (principalReesGenerator a)) := by
  apply Polynomial.ringHom_ext
  · intro r
    simpa only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C] using
      principalReesQuotientHom_C a r
  · simpa only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X] using
      principalReesQuotientHom_X a

/-- Evaluation formula for the polynomial cover. -/
theorem principalReesQuotientHom_apply (a : R) (p : R[X]) :
    principalReesQuotientHom a p =
      Polynomial.eval₂
        (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
          Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
            (Ideal.span ({a} : Set R))))
        (Ideal.Quotient.mk
          (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
            (Ideal.span ({a} : Set R)))
          (principalReesGenerator a)) p := by
  rw [principalReesQuotientHom_eq_eval₂RingHom]
  rfl

/-- A monomial maps to the corresponding power of the degree-one Rees generator. -/
@[simp]
theorem principalReesQuotientHom_monomial (a r : R) (n : ℕ) :
    principalReesQuotientHom a (Polynomial.monomial n r) =
      Ideal.Quotient.mk
        (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))
        (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))) r *
          principalReesGenerator a ^ n) := by
  rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
    principalReesQuotientHom_C_eq_mk, principalReesQuotientHom_X,
    map_mul, map_pow]

/-- Constants and the polynomial variable uniquely characterize the principal Rees cover. -/
theorem principalReesQuotientHom_unique (a : R)
    (f : R[X] →+* (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
      Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
        (Ideal.span ({a} : Set R))))
    (hC : ∀ r : R, f (Polynomial.C r) =
      Ideal.Quotient.mk
        (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))
        (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))) r))
    (hX : f Polynomial.X =
      Ideal.Quotient.mk
        (Ideal.map (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))
          (Ideal.span ({a} : Set R)))
        (principalReesGenerator a)) :
    f = principalReesQuotientHom a := by
  exact Polynomial.ringHom_ext
    (fun r => (hC r).trans (principalReesQuotientHom_C_eq_mk a r).symm)
    (hX.trans (principalReesQuotientHom_X a).symm)

/-- The principal Rees cover respects the original coefficient scalars. -/
@[simp]
theorem principalReesQuotientHom_smul (a r : R) (p : R[X]) :
    principalReesQuotientHom a (r • p) = r • principalReesQuotientHom a p := by
  rw [principalReesQuotientHom_apply_map, Polynomial.map_smul, map_smul]
  exact IsScalarTower.algebraMap_smul (R ⧸ Ideal.span ({a} : Set R)) r
    (principalReesQuotientHom a p)

/-- The principal polynomial cover is surjective without a regularity hypothesis. -/
theorem surjective_principalReesQuotientHom (a : R) :
    Function.Surjective (principalReesQuotientHom a) := by
  intro c
  obtain ⟨p, hp⟩ := reesAlgebra.surjective_principalPolynomialHom a c
  obtain ⟨q, hq⟩ :=
    (Polynomial.map_surjective (f := Ideal.Quotient.mk (Ideal.span ({a} : Set R)))
      Ideal.Quotient.mk_surjective) p
  refine ⟨q, ?_⟩
  rw [principalReesQuotientHom_apply_map, hq, hp]

end Ideal
