module

public import GradedRings.ReesAlgebra.Generation
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.Algebra.Ring.NonZeroDivisors

/-!
# Polynomial maps and equivalences for principal quotient Rees algebras

For a principal ideal generated by `a`, polynomial evaluation at the degree-one class
represented by `a` defines a surjective algebra homomorphism to the quotient Rees
algebra over the coefficient quotient ring. If `a` is regular, `principalPolynomialEquiv`
promotes this evaluation to an algebra equivalence. This includes unit generators and
generators in the zero ring. Composition with augmentation is evaluation at zero.
-/

@[expose] public section

namespace reesAlgebra

universe u

variable {R : Type u} [CommRing R]

/-- Polynomial evaluation at the degree-one quotient monomial represented by the
specified generator of a principal ideal. -/
noncomputable def principalPolynomialHom (a : R) :
    Polynomial (R ⧸ Ideal.span ({a} : Set R)) →ₐ[R ⧸ Ideal.span ({a} : Set R)]
      (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
        (Ideal.span ({a} : Set R)).map
          (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))) :=
  Polynomial.aeval
    (quotientMonomial (Ideal.span ({a} : Set R)) 1
      (Submodule.Quotient.mk
        (p := (Ideal.span ({a} : Set R)) •
          (⊤ : Submodule R ↥((Ideal.span ({a} : Set R)) ^ 1)))
        ⟨a, by simpa only [pow_one] using Ideal.mem_span_singleton_self a⟩))

/-- The polynomial variable maps to the degree-one quotient monomial represented by
its principal ideal generator. -/
@[simp]
theorem principalPolynomialHom_X (a : R) :
    principalPolynomialHom a Polynomial.X =
      quotientMonomial (Ideal.span ({a} : Set R)) 1
        (Submodule.Quotient.mk
          (p := (Ideal.span ({a} : Set R)) •
            (⊤ : Submodule R ↥((Ideal.span ({a} : Set R)) ^ 1)))
          ⟨a, by simpa only [pow_one] using Ideal.mem_span_singleton_self a⟩) :=
  Polynomial.aeval_X _

/-- Constant polynomials map to their coefficient scalars. -/
@[simp]
theorem principalPolynomialHom_C (a : R) (c : R ⧸ Ideal.span ({a} : Set R)) :
    principalPolynomialHom a (Polynomial.C c) =
      algebraMap (R ⧸ Ideal.span ({a} : Set R))
        (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
          (Ideal.span ({a} : Set R)).map
            (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))) c :=
  Polynomial.aeval_C _ c

/-- Augmentation composed with the principal polynomial map is evaluation at zero. -/
theorem augmentation_comp_principalPolynomialHom (a : R) :
    (augmentation (Ideal.span ({a} : Set R))).comp (principalPolynomialHom a) =
      Polynomial.aeval (0 : R ⧸ Ideal.span ({a} : Set R)) := by
  apply Polynomial.algHom_ext
  change augmentation (Ideal.span ({a} : Set R))
      (principalPolynomialHom a Polynomial.X) =
    Polynomial.aeval (0 : R ⧸ Ideal.span ({a} : Set R)) Polynomial.X
  rw [principalPolynomialHom_X, Polynomial.aeval_X]
  have hx := (quotientMonomialEquiv (Ideal.span ({a} : Set R)) 1
    (Submodule.Quotient.mk
      (p := (Ideal.span ({a} : Set R)) •
        (⊤ : Submodule R ↥((Ideal.span ({a} : Set R)) ^ 1)))
      ⟨a, by simpa only [pow_one] using Ideal.mem_span_singleton_self a⟩)).property
  simp only [coe_quotientMonomialEquiv] at hx
  apply augmentation_eq_zero_of_mem_quotientHomogeneousComponent
    (I := Ideal.span ({a} : Set R))
  all_goals try exact hx
  all_goals decide

/-- The augmentation of a polynomial image is its evaluation at zero. -/
@[simp]
theorem augmentation_principalPolynomialHom (a : R)
    (p : Polynomial (R ⧸ Ideal.span ({a} : Set R))) :
    augmentation (Ideal.span ({a} : Set R)) (principalPolynomialHom a p) =
      Polynomial.aeval (0 : R ⧸ Ideal.span ({a} : Set R)) p :=
  DFunLike.congr_fun (augmentation_comp_principalPolynomialHom a) p

/-- The polynomial map onto a principal quotient Rees algebra is surjective. -/
theorem surjective_principalPolynomialHom (a : R) :
    Function.Surjective (principalPolynomialHom a) := by
  let I := Ideal.span ({a} : Set R)
  let A := R ⧸ I
  let C := reesAlgebra I ⧸ I.map (algebraMap R (reesAlgebra I))
  let g : ↥(I ^ 1) :=
    ⟨a, by simpa only [I, pow_one] using Ideal.mem_span_singleton_self a⟩
  have hmem (x : powerQuotient I 1) :
      quotientMonomial I 1 x ∈ (principalPolynomialHom a).range := by
    refine Quotient.inductionOn x fun b => ?_
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp
      (show (b : R) ∈ Ideal.span ({a} : Set R) by
        simpa only [pow_one] using b.property)
    have hb : b = r • g := by
      apply Subtype.ext
      change (b : R) = r * a
      exact hr.symm
    have hclass : (Submodule.Quotient.mk b : powerQuotient I 1) =
        r • Submodule.Quotient.mk g := by
      rw [hb]
      rfl
    refine ⟨Polynomial.C (Ideal.Quotient.mk I r) * Polynomial.X, ?_⟩
    change principalPolynomialHom a
        (Polynomial.C (Ideal.Quotient.mk I r) * Polynomial.X) =
      quotientMonomial I 1 (Submodule.Quotient.mk b)
    rw [map_mul, principalPolynomialHom_C, principalPolynomialHom_X, hclass, map_smul]
    change algebraMap A C (algebraMap R A r) *
        quotientMonomial I 1 (Submodule.Quotient.mk g) =
      r • quotientMonomial I 1 (Submodule.Quotient.mk g)
    rw [← IsScalarTower.algebraMap_apply R A C r]
    exact (Algebra.smul_def r (quotientMonomial I 1 (Submodule.Quotient.mk g))).symm
  apply (AlgHom.range_eq_top (principalPolynomialHom a)).mp
  apply top_unique
  rw [← adjoin_quotientHomogeneousComponent_one I]
  apply Algebra.adjoin_le
  intro c hc
  obtain ⟨x, hx⟩ := (quotientMonomialEquiv I 1).surjective ⟨c, hc⟩
  have hx' : quotientMonomial I 1 x = c := by
    rw [← coe_quotientMonomialEquiv]
    exact congrArg Subtype.val hx
  rw [← hx']
  exact hmem x

/-- For a regular generator, the canonical polynomial map to the quotient Rees
algebra is injective. -/
theorem injective_principalPolynomialHom (a : R) (ha : IsRegular a) :
    Function.Injective (principalPolynomialHom a) := by
  let I : Ideal R := Ideal.span ({a} : Set R)
  let J : Ideal (reesAlgebra I) := I.map (algebraMap R (reesAlgebra I))
  let y : reesAlgebra I := monomial I 1
    ⟨a, by simpa only [pow_one] using Ideal.mem_span_singleton_self a⟩
  let g : Polynomial R →ₐ[R] reesAlgebra I := Polynomial.aeval y
  have hcomp :
      (principalPolynomialHom a).toRingHom.comp
          (Polynomial.mapRingHom (Ideal.Quotient.mk I)) =
        (Ideal.Quotient.mk J).comp g.toRingHom := by
    apply Polynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
      change principalPolynomialHom a (Polynomial.C (Ideal.Quotient.mk I r)) =
        Ideal.Quotient.mk J (g (Polynomial.C r))
      simpa only [g, Polynomial.aeval_C] using
        (principalPolynomialHom_C a (Ideal.Quotient.mk I r)).trans
          (by rw [algebraMap_quotient_mk])
    · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
      change principalPolynomialHom a Polynomial.X =
        Ideal.Quotient.mk J (g Polynomial.X)
      simpa only [g, Polynomial.aeval_X, y, quotientMonomial_mk] using
        principalPolynomialHom_X a
  have hval :
      (reesAlgebra I).val.comp g =
        Polynomial.aeval (Polynomial.C a * Polynomial.X) := by
    apply Polynomial.algHom_ext
    simp only [AlgHom.comp_apply, g, Polynomial.aeval_X]
    change Polynomial.monomial 1 a = Polynomial.C a * Polynomial.X
    exact Polynomial.C_mul_X_eq_monomial.symm
  have hcoeff (P : Polynomial R) (n : ℕ) :
      ((g P : reesAlgebra I) : Polynomial R).coeff n = P.coeff n * a ^ n := by
    have heval := DFunLike.congr_fun hval P
    change ((g P : reesAlgebra I) : Polynomial R) =
      Polynomial.aeval (Polynomial.C a * Polynomial.X) P at heval
    rw [heval, ← Polynomial.comp_eq_aeval]
    exact Polynomial.comp_C_mul_X_coeff (p := P) (r := a) (n := n)
  intro p q hpq
  apply sub_eq_zero.mp
  obtain ⟨P, hP⟩ :=
    Polynomial.map_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective (p - q)
  have hzero : principalPolynomialHom a (Polynomial.map (Ideal.Quotient.mk I) P) = 0 := by
    rw [hP, map_sub, hpq, sub_self]
  have hgzero : Ideal.Quotient.mk J (g P) = 0 :=
    (DFunLike.congr_fun hcomp P).symm.trans hzero
  have hgmem : g P ∈ Ideal.span ({algebraMap R (reesAlgebra I) a} : Set (reesAlgebra I)) := by
    have hg : g P ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp hgzero
    simpa only [J, I, Ideal.map_span, Set.image_singleton] using hg
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hgmem
  rw [← hP]
  apply Polynomial.ext
  intro n
  rw [Polynomial.coeff_map, Polynomial.coeff_zero]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  have hbn : (b : Polynomial R).coeff n ∈ I ^ n := b.property n
  have hm : P.coeff n * a ^ n ∈ I ^ (n + 1) := by
    rw [← hcoeff P n, hb]
    change (Polynomial.C a * (b : Polynomial R)).coeff n ∈ I ^ (n + 1)
    rw [Polynomial.coeff_C_mul, pow_succ']
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self a) hbn
  have hdiv : a ^ n * a ∣ a ^ n * P.coeff n := by
    simpa only [I, Ideal.span_singleton_pow, Ideal.span_singleton_mul_span_singleton,
      Ideal.mem_span_singleton, pow_succ, mul_comm] using hm
  exact Ideal.mem_span_singleton.mpr
    (((IsRegular.pow n ha).left.dvd_cancel_left).mp hdiv)

/-- For a regular generator, the principal polynomial map is bijective. -/
theorem bijective_principalPolynomialHom (a : R) (ha : IsRegular a) :
    Function.Bijective (principalPolynomialHom a) :=
  ⟨injective_principalPolynomialHom a ha, surjective_principalPolynomialHom a⟩

/-- Polynomial evaluation identifies the polynomial algebra over the coefficient
quotient with the quotient Rees algebra of a regular principal ideal. -/
noncomputable def principalPolynomialEquiv (a : R) (ha : IsRegular a) :
    Polynomial (R ⧸ Ideal.span ({a} : Set R)) ≃ₐ[R ⧸ Ideal.span ({a} : Set R)]
      (reesAlgebra (Ideal.span ({a} : Set R)) ⧸
        (Ideal.span ({a} : Set R)).map
          (algebraMap R (reesAlgebra (Ideal.span ({a} : Set R))))) :=
  AlgEquiv.ofBijective (principalPolynomialHom a) (bijective_principalPolynomialHom a ha)

/-- The forward algebra homomorphism of the equivalence is principal evaluation. -/
@[simp]
theorem principalPolynomialEquiv_toAlgHom (a : R) (ha : IsRegular a) :
    (principalPolynomialEquiv a ha).toAlgHom = principalPolynomialHom a :=
  rfl

/-- The polynomial equivalence evaluates by the principal polynomial map. -/
@[simp]
theorem principalPolynomialEquiv_apply (a : R) (ha : IsRegular a)
    (p : Polynomial (R ⧸ Ideal.span ({a} : Set R))) :
    principalPolynomialEquiv a ha p = principalPolynomialHom a p :=
  rfl

/-- The inverse equivalence recovers a polynomial from its principal evaluation. -/
@[simp]
theorem principalPolynomialEquiv_symm_apply_hom (a : R) (ha : IsRegular a)
    (p : Polynomial (R ⧸ Ideal.span ({a} : Set R))) :
    (principalPolynomialEquiv a ha).symm (principalPolynomialHom a p) = p := by
  simpa only [principalPolynomialEquiv_apply] using
    (principalPolynomialEquiv a ha).symm_apply_apply p

/-- Augmentation composed with the principal polynomial equivalence is evaluation
at zero. -/
theorem augmentation_comp_principalPolynomialEquiv (a : R) (ha : IsRegular a) :
    (augmentation (Ideal.span ({a} : Set R))).comp
        (principalPolynomialEquiv a ha).toAlgHom =
      Polynomial.aeval (0 : R ⧸ Ideal.span ({a} : Set R)) := by
  rw [principalPolynomialEquiv_toAlgHom]
  exact augmentation_comp_principalPolynomialHom a

end reesAlgebra
