module

public import GradedRings.ReesAlgebra
public import GradedRings.Quotient

/-!
# The natural grading on the Rees algebra

The degree-`q` component of `reesAlgebra I` consists of the monomials `a X^q`
with `a ∈ I ^ q`. It is a submodule of the existing Rees algebra, not a
replacement coefficient ring. Projection to degree `q` retains precisely the
`q`th polynomial coefficient.

The extension of `I` to the Rees algebra is generated by homogeneous constants.
Its quotient therefore has the image grading supplied by `Ideal.Quotient.gradedRing`.

## Implementation notes

The homogeneous-ideal argument uses Mathlib's `Ideal.homogeneous_span` on the
images of the elements of `I`, all in degree zero. The quotient components are
images under the existing quotient map. No identification of these components
with quotients of consecutive ideal powers is used here.

## References

* Andrew Yang's Rees algebra in Mathlib supplies the polynomial subalgebra and
  the criterion for a monomial to belong to it.
* Mathlib's internal graded rings and homogeneous ideals, and the image-grading
  quotient construction in `GradedRings.Quotient`.
* K. Fujiwara and F. Kato, *Foundations of Rigid Geometry I*, arXiv:1308.4734v5,
  Chapter 0, §7.5, for the Rees-quotient presentation of the associated graded.
-/

@[expose] public section

universe u

namespace reesAlgebra

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- The degree-`q` monomial in the Rees algebra with coefficient in `I ^ q`. -/
noncomputable def monomial (q : ℕ) : ↥(I ^ q) →ₗ[R] reesAlgebra I where
  toFun a := ⟨Polynomial.monomial q (a : R), monomial_mem.mpr a.property⟩
  map_add' a b := Subtype.ext (map_add (Polynomial.monomial q) (a : R) (b : R))
  map_smul' r a := Subtype.ext (map_smul (Polynomial.monomial q) r (a : R))

/-- Coercing a Rees monomial gives its polynomial monomial. -/
@[simp]
theorem coe_monomial (q : ℕ) (a : ↥(I ^ q)) :
    ((monomial I q a : reesAlgebra I) : Polynomial R) = Polynomial.monomial q (a : R) :=
  rfl

/-- The degree-`q` submodule inside the canonical Rees algebra. -/
noncomputable def homogeneousComponent (q : ℕ) : Submodule R (reesAlgebra I) :=
  ((Polynomial.monomial q : R →ₗ[R] Polynomial R).range).comap
    ((reesAlgebra I).val.toLinearMap)

/-- A Rees element is homogeneous of degree `q` exactly when it is a degree-`q` monomial. -/
theorem mem_homogeneousComponent_iff (q : ℕ) (p : reesAlgebra I) :
    p ∈ homogeneousComponent I q ↔ ∃ a : ↥(I ^ q), monomial I q a = p := by
  constructor
  · rintro ⟨a, ha⟩
    have haI : a ∈ I ^ q := monomial_mem.mp (ha ▸ p.property)
    exact ⟨⟨a, haI⟩, Subtype.ext ha⟩
  · rintro ⟨a, rfl⟩
    exact ⟨(a : R), rfl⟩

/-- Every monomial with coefficient in `I ^ q` belongs to the degree-`q` component. -/
theorem monomial_mem_homogeneousComponent (q : ℕ) (a : ↥(I ^ q)) :
    monomial I q a ∈ homogeneousComponent I q :=
  (mem_homogeneousComponent_iff I q _).mpr ⟨a, rfl⟩

/-- A homogeneous Rees element is recovered from its coefficient in its degree. -/
theorem coe_eq_monomial_of_mem_homogeneousComponent {q : ℕ} {p : reesAlgebra I}
    (hp : p ∈ homogeneousComponent I q) :
    (p : Polynomial R) = Polynomial.monomial q ((p : Polynomial R).coeff q) := by
  obtain ⟨a, rfl⟩ := (mem_homogeneousComponent_iff I q p).mp hp
  simp

/-- The coefficient module `I ^ q` is linearly equivalent to the degree-`q` Rees component. -/
noncomputable def monomialEquiv (q : ℕ) : ↥(I ^ q) ≃ₗ[R] homogeneousComponent I q :=
  LinearEquiv.ofBijective
    ((monomial I q).codRestrict _ (monomial_mem_homogeneousComponent I q))
    ⟨fun a b h => Subtype.ext <| Polynomial.monomial_injective q <|
        congrArg (fun p : homogeneousComponent I q => ((p : reesAlgebra I) : Polynomial R)) h,
      fun p => by
        obtain ⟨a, ha⟩ := (mem_homogeneousComponent_iff I q p).mp p.property
        exact ⟨a, Subtype.ext ha⟩⟩

/-- The forward monomial equivalence has the prescribed Rees value. -/
@[simp]
theorem coe_monomialEquiv (q : ℕ) (a : ↥(I ^ q)) :
    (monomialEquiv I q a : reesAlgebra I) = monomial I q a :=
  rfl

/-- The polynomial value of the monomial equivalence is its monomial. -/
theorem coe_coe_monomialEquiv (q : ℕ) (a : ↥(I ^ q)) :
    ((monomialEquiv I q a : reesAlgebra I) : Polynomial R) =
      Polynomial.monomial q (a : R) :=
  rfl

/-- The inverse monomial equivalence extracts the coefficient in its degree. -/
@[simp]
theorem coeff_monomialEquiv_symm (q : ℕ) (p : homogeneousComponent I q) :
    ((monomialEquiv I q).symm p : R) = ((p : reesAlgebra I) : Polynomial R).coeff q := by
  have h := congrArg
    (fun x : homogeneousComponent I q => ((x : reesAlgebra I) : Polynomial R).coeff q)
    ((monomialEquiv I q).apply_symm_apply p)
  simpa only [coe_coe_monomialEquiv, Polynomial.coeff_monomial_same] using h

/-- Multiplication of Rees monomials multiplies coefficients and adds degrees. -/
theorem monomial_mul_monomial (q r : ℕ) (a : ↥(I ^ q)) (b : ↥(I ^ r)) :
    monomial I q a * monomial I r b =
      monomial I (q + r) ⟨(a : R) * (b : R), by
        rw [pow_add]
        exact Ideal.mul_mem_mul a.property b.property⟩ := by
  apply Subtype.ext
  exact Polynomial.monomial_mul_monomial _ _ _ _

/-- A degree-zero Rees monomial is the corresponding coefficient scalar. -/
@[simp]
theorem monomial_zero (a : ↥(I ^ 0)) :
    monomial I 0 a = algebraMap R (reesAlgebra I) (a : R) := by
  apply Subtype.ext
  exact Polynomial.monomial_zero_left (a := (a : R))

/-- The degree-zero monomial with coefficient one is the Rees unit. -/
theorem monomial_zero_one : monomial I 0 ⟨1, by simp⟩ = 1 := by
  rw [monomial_zero, map_one]

/-- The canonical Rees algebra decomposes as the sum of its monomial-degree submodules. -/
noncomputable instance instGradedRingHomogeneousComponent :
    GradedRing (homogeneousComponent I) := by
  classical
  letI : SetLike.GradedMonoid (homogeneousComponent I) :=
    { one_mem := by
        simpa only [monomial_zero_one] using
          monomial_mem_homogeneousComponent I 0 ⟨1, by simp⟩
      mul_mem := by
        intro q r p s hp hs
        obtain ⟨a, rfl⟩ := (mem_homogeneousComponent_iff I q p).mp hp
        obtain ⟨b, rfl⟩ := (mem_homogeneousComponent_iff I r s).mp hs
        rw [monomial_mul_monomial]
        exact monomial_mem_homogeneousComponent I _ _ }
  apply DirectSum.IsInternal.gradedAlgebra
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · rw [iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero]
    intro s v hv hz i hi
    have hc : (∑ j ∈ s, ((v j : reesAlgebra I) : Polynomial R).coeff i) = 0 := by
      simpa using congrArg (fun p : reesAlgebra I => (p : Polynomial R).coeff i) hz
    have hji : ∀ j ∈ s, j ≠ i → ((v j : reesAlgebra I) : Polynomial R).coeff i = 0 := by
      intro j hj hne
      rw [coe_eq_monomial_of_mem_homogeneousComponent I (hv j hj)]
      simp [Polynomial.coeff_monomial, hne]
    have hci : ((v i : reesAlgebra I) : Polynomial R).coeff i = 0 := by
      rwa [Finset.sum_eq_single i hji (fun h => (h hi).elim)] at hc
    apply Subtype.ext
    rw [coe_eq_monomial_of_mem_homogeneousComponent I (hv i hi), hci]
    simp
  · apply top_unique
    intro p _
    have hp : p = ∑ q ∈ (p : Polynomial R).support,
        monomial I q ⟨(p : Polynomial R).coeff q, p.property q⟩ := by
      apply Subtype.ext
      simpa using (p : Polynomial R).as_sum_support
    rw [hp]
    exact Submodule.sum_mem _ fun q _ =>
      Submodule.mem_iSup_of_mem q (monomial_mem_homogeneousComponent I q _)

/-- The homogeneous projection keeps exactly the corresponding polynomial coefficient. -/
theorem coe_proj_homogeneousComponent (q : ℕ) (p : reesAlgebra I) :
    ((GradedRing.proj (homogeneousComponent I) q p : reesAlgebra I) : Polynomial R) =
      Polynomial.monomial q ((p : Polynomial R).coeff q) := by
  classical
  refine DirectSum.Decomposition.inductionOn (homogeneousComponent I) ?_ ?_ ?_ p
  · simp
  · intro r x
    obtain ⟨a, ha⟩ := (mem_homogeneousComponent_iff I r x).mp x.property
    by_cases hr : r = q
    · subst r
      rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same _ x.property]
      simp only [← ha, coe_monomial, Polynomial.coeff_monomial_same]
    · rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne _ x.property hr]
      simp [← ha, Polynomial.coeff_monomial, hr]
  · intro x y hx hy
    simp only [map_add, Subalgebra.coe_add, Polynomial.coeff_add]
    rw [hx, hy]

/-- Coefficient scalars in the Rees algebra are homogeneous of degree zero. -/
theorem algebraMap_mem_homogeneousComponent_zero (r : R) :
    algebraMap R (reesAlgebra I) r ∈ homogeneousComponent I 0 := by
  simpa only [monomial_zero] using
    monomial_mem_homogeneousComponent I 0 ⟨r, by simp⟩

/-- The extension of `I` to its Rees algebra is a homogeneous ideal. -/
theorem extendedIdeal_isHomogeneous :
    (I.map (algebraMap R (reesAlgebra I))).IsHomogeneous (homogeneousComponent I) := by
  rw [← Ideal.span_eq I, Ideal.map_span]
  apply Ideal.homogeneous_span
  rintro _ ⟨r, _, rfl⟩
  exact ⟨0, algebraMap_mem_homogeneousComponent_zero I r⟩

/-- The degree-`q` component of the canonical quotient Rees algebra is the image component. -/
noncomputable def quotientHomogeneousComponent (q : ℕ) :
    AddSubgroup (reesAlgebra I ⧸ I.map (algebraMap R (reesAlgebra I))) :=
  Ideal.Quotient.gradedComponent (homogeneousComponent I)
    (I.map (algebraMap R (reesAlgebra I))) q

/-- The canonical quotient Rees algebra has the image grading of its homogeneous quotient. -/
noncomputable instance instGradedRingQuotientHomogeneousComponent :
    GradedRing (quotientHomogeneousComponent I) :=
  Ideal.Quotient.gradedRing (homogeneousComponent I)
    (I.map (algebraMap R (reesAlgebra I))) (extendedIdeal_isHomogeneous I)

/-- Membership in a quotient component is witnessed by a representative in the Rees component. -/
theorem mem_quotientHomogeneousComponent_iff (q : ℕ)
    (c : reesAlgebra I ⧸ I.map (algebraMap R (reesAlgebra I))) :
    c ∈ quotientHomogeneousComponent I q ↔
      ∃ p : reesAlgebra I, p ∈ homogeneousComponent I q ∧
        Ideal.Quotient.mk (I.map (algebraMap R (reesAlgebra I))) p = c :=
  Iff.rfl

end reesAlgebra
