module

public import GradedRings.ReesAlgebra.Augmentation
public import GradedRings.ReesAlgebra.QuotientPieces
public import Mathlib.RingTheory.FiniteType
import Mathlib.Tactic.Ring

/-!
# Generation of the quotient Rees algebra

The quotient Rees algebra is generated over the residue ring by its homogeneous
component of degree one. This component also generates the augmentation ideal.
Finiteness of the degree-one power quotient therefore implies finite type over the
residue ring; finite generation of the original ideal is another sufficient condition.
-/

@[expose] public section

open scoped Polynomial

namespace reesAlgebra

universe u

variable {R : Type u} [CommRing R] (I : Ideal R)

local notation "B" => reesAlgebra I
local notation "J" => I.map (algebraMap R B)
local notation "A" => R ⧸ I
local notation "C" => B ⧸ J

/-- The quotient Rees algebra is generated over the residue ring by its homogeneous
component of degree one. -/
theorem adjoin_quotientHomogeneousComponent_one :
    Algebra.adjoin A (quotientHomogeneousComponent I 1 : Set C) = ⊤ := by
  let S : Set R[X] :=
    (Submodule.map (Polynomial.monomial 1 : R →ₗ[R] R[X]) I : Set R[X])
  have hgen : Algebra.adjoin R (Subtype.val ⁻¹' S : Set B) = ⊤ := by
    have hS : Algebra.adjoin R S = reesAlgebra I :=
      adjoin_monomial_eq_reesAlgebra I
    rw [← hS]
    exact Algebra.adjoin_adjoin_coe_preimage
  let T := Algebra.adjoin A (quotientHomogeneousComponent I 1 : Set C)
  let q : B →ₐ[R] C := Ideal.Quotient.mkₐ R J
  have hle : Algebra.adjoin R (Subtype.val ⁻¹' S : Set B) ≤
      (T.restrictScalars R).comap q := by
    apply Algebra.adjoin_le
    rintro b ⟨r, _, hrb⟩
    change q b ∈ T
    apply Algebra.subset_adjoin
    let a : ↥(I ^ 1) :=
      ⟨r, reesAlgebra.monomial_mem.mp (hrb.symm ▸ b.property)⟩
    have hb : monomial I 1 a = b := by
      apply Subtype.ext
      exact hrb
    have hm : quotientMonomial I 1 (Submodule.Quotient.mk a) ∈
        quotientHomogeneousComponent I 1 := by
      rw [← quotientComponentSubmodule_toAddSubgroup I 1]
      change quotientMonomial I 1 (Submodule.Quotient.mk a) ∈
        quotientComponentSubmodule I 1
      rw [← quotientMonomial_range I 1]
      exact ⟨_, rfl⟩
    simpa [q, quotientMonomial_mk, hb] using hm
  have hall : (⊤ : Subalgebra R B) ≤ (T.restrictScalars R).comap q := by
    rwa [hgen] at hle
  apply top_unique
  intro c _
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
  exact hall (show b ∈ (⊤ : Subalgebra R B) from trivial)

/-- The augmentation ideal of the quotient Rees algebra is generated by the homogeneous
component of degree one. -/
theorem ker_augmentation :
    RingHom.ker (augmentation I).toRingHom =
      Ideal.span (quotientHomogeneousComponent I 1 : Set C) := by
  let K : Ideal C := Ideal.span (quotientHomogeneousComponent I 1 : Set C)
  have hkill (c : C) (hc : c ∈ quotientHomogeneousComponent I 1) :
      augmentation I c = 0 := by
    apply augmentation_eq_zero_of_mem_quotientHomogeneousComponent (I := I)
    all_goals try exact hc
    all_goals decide
  have hres (c : C) : c - algebraMap A C (augmentation I c) ∈ K := by
    have hc : c ∈ Algebra.adjoin A (quotientHomogeneousComponent I 1 : Set C) := by
      rw [adjoin_quotientHomogeneousComponent_one]
      trivial
    refine Algebra.adjoin_induction
      (p := fun x _ => x - algebraMap A C (augmentation I x) ∈ K) ?_ ?_ ?_ ?_ hc
    · intro x hx
      rw [hkill x hx, map_zero, sub_zero]
      exact Ideal.subset_span hx
    · intro a
      simp
    · intro x y _ _ hx hy
      simpa only [map_add, add_sub_add_comm] using K.add_mem hx hy
    · intro x y _ _ hx hy
      convert K.add_mem (K.mul_mem_left x hy)
        (K.mul_mem_left (algebraMap A C (augmentation I y)) hx) using 1
      simp only [map_mul]
      ring
  refine le_antisymm ?_ (Ideal.span_le.mpr ?_)
  · intro c hc
    change augmentation I c = 0 at hc
    simpa only [hc, map_zero, sub_zero] using hres c
  · intro c hc
    exact hkill c hc

/-- A finite degree-one power quotient makes the quotient Rees algebra finite type over
the residue ring. -/
theorem finiteType_of_finite_powerQuotient_one [Module.Finite A (powerQuotient I 1)] :
    Algebra.FiniteType A C := by
  let f : powerQuotient I 1 →ₗ[A] C :=
    (quotientMonomial I 1).extendScalarsOfSurjective Ideal.Quotient.mk_surjective
  have hrange : (LinearMap.range f : Set C) =
      (quotientHomogeneousComponent I 1 : Set C) := by
    calc
      (LinearMap.range f : Set C) =
          (LinearMap.range (quotientMonomial I 1) : Set C) := by
        ext c
        change (∃ a, f a = c) ↔ (∃ a, quotientMonomial I 1 a = c)
        simp only [f, LinearMap.extendScalarsOfSurjective_apply]
      _ = (quotientComponentSubmodule I 1 : Set C) := by
        rw [quotientMonomial_range]
      _ = (quotientHomogeneousComponent I 1 : Set C) :=
        congrArg (fun H : AddSubgroup C => (H : Set C))
          (quotientComponentSubmodule_toAddSubgroup I 1)
  obtain ⟨s, hs⟩ := Submodule.fg_range f
  refine ⟨⟨s, ?_⟩⟩
  rw [← Algebra.adjoin_span, hs, hrange, adjoin_quotientHomogeneousComponent_one]

/-- A finitely generated ideal has a quotient Rees algebra of finite type over its
residue ring. -/
theorem finiteType_of_fg (hI : I.FG) : Algebra.FiniteType A C := by
  have hB := reesAlgebra.fg hI
  rw [Subalgebra.fg_iff_finiteType] at hB
  have : Algebra.FiniteType R B := hB
  have : Algebra.FiniteType R C := inferInstance
  exact Algebra.FiniteType.of_restrictScalars_finiteType R A C

end reesAlgebra
